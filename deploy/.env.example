# Copie este archivo como deploy/.env y reemplace todos los valores.
# deploy/.env está excluido de Git y no debe versionarse.

# Ruta del repositorio backend. Por defecto se asume la estructura local
# usada en el proyecto: ../IdeaProjects/CalidadSoftware.
BACKEND_CONTEXT=../../IdeaProjects/CalidadSoftware

# Puerto público del frontend en el host.
HTTP_PORT=8088

# Nombre del servidor en Nginx. Use el dominio real en producción.
SERVER_NAME=_

# Origen público permitido por el CORS del backend. Debe coincidir con
# el esquema, dominio y puerto desde donde se abre la SPA.
FIXTECH_CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Credenciales de MySQL para el contenedor.
MYSQL_ROOT_PASSWORD=CAMBIE_ESTA_CLAVE_ROOT
MYSQL_USER=fixtech
MYSQL_PASSWORD=CAMBIE_ESTA_CLAVE_APP

# Genere uno con: openssl rand -hex 32
FIXTECH_JWT_SECRET=CAMBIE_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_64_CARACTERES

# Correo opcional.
FIXTECH_CORREO_HABILITADO=false
FIXTECH_CORREO_REMITENTE=no-reply@fixtech.pe
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
